+def construct_module_on_device(
+    model_class: type[ModuleT],
+    model_kwargs: dict[str, Any],
+    *,
+    device: str | torch.device,
+    torch_dtype: torch.dtype,
+) -> ModuleT:
+    """Construct a module on its target device without an intermediate CPU fp32 copy."""
+    target_device = torch.device(device)
+    previous_dtype = torch.get_default_dtype()
+    try:
+        # ``Module(...).to(device, dtype)`` first materializes all parameters on
+        # CPU in the process-wide default dtype. For Wan2.2-TI2V-5B that hidden
+        # staging allocation alone is about 18.6 GiB. The device context also
+        # covers plain tensor attributes such as RoPE caches and VAE scales.
+        torch.set_default_dtype(torch_dtype)
+        with target_device:
+            model = model_class(**model_kwargs)
+    finally:
+        torch.set_default_dtype(previous_dtype)
+
+    # Normalize any parameters or registered buffers whose constructors used an
+    # explicit device/dtype. This is normally a no-op for the FastWAM modules.
+    return model.to(device=target_device, dtype=torch_dtype)
+
