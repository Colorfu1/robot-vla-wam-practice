+def load_checkpoint_cpu(file_path):
+    """Load a trusted torch checkpoint without eagerly paging all tensor data in."""
+    try:
+        return torch.load(file_path, map_location="cpu", weights_only=True, mmap=True)
+    except (RuntimeError, TypeError):
+        # Keep compatibility with older torch versions and legacy checkpoints
+        # that do not support memory mapping.
+        pass
+    try:
+        return torch.load(file_path, map_location="cpu", weights_only=True)
+    except TypeError:
+        return torch.load(file_path, map_location="cpu")
+
+
+def load_safetensors_into_model(
+    model: torch.nn.Module,
+    file_path,
+    *,
+    device: str | torch.device,
+    torch_dtype: torch.dtype,
+    state_dict_converter: Callable[[dict[str, torch.Tensor]], dict[str, torch.Tensor]]
+    | None = None,
+) -> int:
+    """Copy one safetensors tensor at a time into an already materialized model."""
+    target_state = model.state_dict()
+    copied = 0
+    with safe_open(os.fspath(file_path), framework="pt", device=str(device)) as checkpoint:
+        for source_key in checkpoint.keys():
+            value = checkpoint.get_tensor(source_key)
+            if value.dtype != torch_dtype and (value.is_floating_point() or value.is_complex()):
+                value = value.to(dtype=torch_dtype)
+            item = {source_key: value}
+            if state_dict_converter is not None:
+                item = state_dict_converter(item)
+            with torch.no_grad():
+                for target_key, source_value in item.items():
+                    target_value = target_state.get(target_key)
+                    if target_value is None:
+                        continue
+                    target_value.copy_(source_value)
+                    copied += 1
+            del item, value
+    return copied
+
