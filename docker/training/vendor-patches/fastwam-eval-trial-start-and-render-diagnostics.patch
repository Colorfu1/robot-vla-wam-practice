+def _w0_diag_enabled() -> bool:
+    return os.environ.get("W0_DIAG") == "1"
+
+
+def _w0_diag_interval() -> int:
+    try:
+        return max(1, int(os.environ.get("W0_DIAG_INTERVAL", "25")))
+    except ValueError as error:
+        raise ValueError("W0_DIAG_INTERVAL must be a positive integer") from error
