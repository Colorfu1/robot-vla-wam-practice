+def _w0_diag_snapshot(stage: str, *, env=None, episode_idx: int | None = None, timestep: int | None = None) -> None:
+    """Emit compact native-renderer state for remote abort diagnosis."""
+
+    if not _w0_diag_enabled():
+        return
+
+    fields = {
+        "stage": stage,
+        "pid": os.getpid(),
+        "episode": episode_idx,
+        "timestep": timestep,
+        "hard_reset": os.environ.get("W0_HARD_RESET", "default_true"),
+        "reuse_env": os.environ.get("W0_REUSE_ENV", "0"),
+        "cuda_visible_devices": os.environ.get("CUDA_VISIBLE_DEVICES", "unset"),
+        "mujoco_egl_device_id": os.environ.get("MUJOCO_EGL_DEVICE_ID", "unset"),
+    }
+
+    if env is not None:
+        sim_env = getattr(env, "env", env)
+        sim = getattr(sim_env, "sim", None)
+        render_context = getattr(sim, "_render_context_offscreen", None)
+        fields["sim_id"] = id(sim) if sim is not None else None
+        fields["render_context_id"] = id(render_context) if render_context is not None else None
+        fields["gl_context_id"] = id(getattr(render_context, "gl_ctx", None)) if render_context is not None else None
+
+    payload = " ".join(f"{key}={value}" for key, value in fields.items())
+    print(f"[W0-DIAG] {payload}", flush=True)
