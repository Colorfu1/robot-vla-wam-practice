+def _step_with_render_diagnostics(env, action, *, episode_idx: int, timestep: int):
+    """Validate and optionally trace an action immediately before env.step.
+
+    A native EGL abort does not give Python a chance to report the preceding
+    action.  Keep the normal path identical, but fail clearly on non-finite
+    actions and provide an opt-in trace for remote renderer probes.
+    """
+
+    action_array = np.asarray(action, dtype=np.float64)
+    if action_array.ndim != 1 or action_array.size != 7:
+        raise ValueError(
+            f"LIBERO action must be a finite 7D vector, got shape={action_array.shape} "
+            f"episode={episode_idx} timestep={timestep}"
+        )
+    action_scale = os.environ.get("W0_ACTION_SCALE")
+    if action_scale is not None:
+        try:
+            action_array *= float(action_scale)
+        except ValueError as exc:
+            raise ValueError(f"W0_ACTION_SCALE must be numeric, got {action_scale!r}") from exc
+    if not np.isfinite(action_array).all():
+        raise ValueError(
+            f"LIBERO action contains non-finite values episode={episode_idx} "
+            f"timestep={timestep} action={action_array.tolist()}"
+        )
+
+    if os.environ.get("W0_RENDER_DIAGNOSTIC") == "1":
+        sim_env = getattr(env, "env", env)
+        sim = getattr(sim_env, "sim", None)
+        data = getattr(sim, "data", None)
+        qpos = np.asarray(getattr(data, "qpos", []), dtype=np.float64)
+        qvel = np.asarray(getattr(data, "qvel", []), dtype=np.float64)
+        qpos_max = float(np.max(np.abs(qpos))) if qpos.size else None
+        qvel_max = float(np.max(np.abs(qvel))) if qvel.size else None
+        print(
+            f"[W0-RENDER-TRACE] episode={episode_idx} timestep={timestep} "
+            f"action_min={float(np.min(action_array)):.6g} "
+            f"action_max={float(np.max(action_array)):.6g} "
+            f"action_norm={float(np.linalg.norm(action_array)):.6g} "
+            f"qpos_max={qpos_max} qvel_max={qvel_max}",
+            flush=True,
+        )
+    if _w0_diag_enabled() and timestep % _w0_diag_interval() == 0:
+        _w0_diag_snapshot("before_step", env=env, episode_idx=episode_idx, timestep=timestep)
+    result = env.step(action_array)
+    if _w0_diag_enabled() and timestep % _w0_diag_interval() == 0:
+        _w0_diag_snapshot("after_step", env=env, episode_idx=episode_idx, timestep=timestep)
+    return result
+
